<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.vb.mapper.VbVectorDataMapper">
    
    <resultMap type="VbVectorData" id="VbVectorDataResult">
        <result property="dataId"      column="data_id"      />
        <result property="storeId"     column="store_id"     />
        <result property="content"     column="content"      />
        <result property="embedding"   column="embedding"    />
        <result property="metadata"    column="metadata"     />
        <result property="status"      column="status"       />
        <result property="delFlag"     column="del_flag"     />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>
    
    <sql id="selectDataVo">
        select data_id, store_id, content, embedding, metadata, status, del_flag, create_by, create_time, update_by, update_time, remark 
        from vb_vector_data
    </sql>
    
    <select id="selectDataById" parameterType="Long" resultMap="VbVectorDataResult">
        <include refid="selectDataVo"/>
        where data_id = #{dataId} and del_flag = '0'
    </select>
    
    <select id="selectDataByStoreId" parameterType="Long" resultMap="VbVectorDataResult">
        <include refid="selectDataVo"/>
        where store_id = #{storeId} and del_flag = '0'
        order by create_time desc
    </select>
    
    <select id="selectDataList" parameterType="VbVectorData" resultMap="VbVectorDataResult">
        <include refid="selectDataVo"/>
        <where>
            del_flag = '0'
            <if test="storeId != null">
                AND store_id = #{storeId}
            </if>
            <if test="content != null and content != ''">
                AND content like concat('%', #{content}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>
    
    <insert id="insertData" parameterType="VbVectorData" useGeneratedKeys="true" keyProperty="dataId">
        insert into vb_vector_data (
            <if test="storeId != null">store_id,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="embedding != null and embedding != ''">embedding,</if>
            <if test="metadata != null and metadata != ''">metadata,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="storeId != null">#{storeId},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="embedding != null and embedding != ''">#{embedding},</if>
            <if test="metadata != null and metadata != ''">#{metadata},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>
    
    <update id="updateData" parameterType="VbVectorData">
        update vb_vector_data 
        <set>
            <if test="content != null">content = #{content},</if>
            <if test="embedding != null">embedding = #{embedding},</if>
            <if test="metadata != null">metadata = #{metadata},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where data_id = #{dataId}
    </update>
    
    <update id="deleteDataById" parameterType="Long">
        update vb_vector_data set del_flag = '2' where data_id = #{dataId}
    </update>
    
    <update id="deleteDataByStoreId" parameterType="Long">
        update vb_vector_data set del_flag = '2' where store_id = #{storeId}
    </update>
    
    <update id="deleteDataByIds" parameterType="String">
        update vb_vector_data set del_flag = '2' where data_id in 
        <foreach item="dataId" collection="array" open="(" separator="," close=")">
            #{dataId}
        </foreach>
    </update>
    
</mapper>

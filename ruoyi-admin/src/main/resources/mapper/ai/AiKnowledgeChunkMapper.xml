<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AiKnowledgeChunkMapper">
    
    <resultMap type="AiKnowledgeChunk" id="AiKnowledgeChunkResult">
        <result property="chunkId"        column="chunk_id"        />
        <result property="fileId"         column="file_id"         />
        <result property="knowledgeId"    column="knowledge_id"    />
        <result property="content"        column="content"         />
        <result property="embedding"      column="embedding"       />
        <result property="chunkIndex"     column="chunk_index"     />
        <result property="status"         column="status"          />
        <result property="createTime"     column="create_time"     />
    </resultMap>
    
    <sql id="selectChunkVo">
        select chunk_id, file_id, knowledge_id, content, embedding, chunk_index, status, create_time 
        from ai_knowledge_chunk
    </sql>
    
    <select id="selectChunkById" parameterType="Long" resultMap="AiKnowledgeChunkResult">
        <include refid="selectChunkVo"/>
        where chunk_id = #{chunkId}
    </select>
    
    <select id="selectChunksByFileId" parameterType="Long" resultMap="AiKnowledgeChunkResult">
        <include refid="selectChunkVo"/>
        where file_id = #{fileId}
        order by chunk_index asc
    </select>
    
    <select id="selectChunksByKnowledgeId" parameterType="Long" resultMap="AiKnowledgeChunkResult">
        <include refid="selectChunkVo"/>
        where knowledge_id = #{knowledgeId}
        order by file_id asc, chunk_index asc
    </select>
    
    <insert id="insertChunk" parameterType="AiKnowledgeChunk" useGeneratedKeys="true" keyProperty="chunkId">
        insert into ai_knowledge_chunk (
            <if test="fileId != null">file_id,</if>
            <if test="knowledgeId != null">knowledge_id,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="embedding != null and embedding != ''">embedding,</if>
            <if test="chunkIndex != null">chunk_index,</if>
            <if test="status != null and status != ''">status,</if>
            create_time
        )values(
            <if test="fileId != null">#{fileId},</if>
            <if test="knowledgeId != null">#{knowledgeId},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="embedding != null and embedding != ''">#{embedding},</if>
            <if test="chunkIndex != null">#{chunkIndex},</if>
            <if test="status != null and status != ''">#{status},</if>
            sysdate()
        )
    </insert>
    
    <insert id="batchInsertChunks">
        insert into ai_knowledge_chunk (file_id, knowledge_id, content, embedding, chunk_index, status, create_time)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.fileId}, #{item.knowledgeId}, #{item.content}, #{item.embedding}, #{item.chunkIndex}, #{item.status}, sysdate())
        </foreach>
    </insert>
    
    <delete id="deleteChunksByFileId" parameterType="Long">
        delete from ai_knowledge_chunk where file_id = #{fileId}
    </delete>
    
    <delete id="deleteChunksByKnowledgeId" parameterType="Long">
        delete from ai_knowledge_chunk where knowledge_id = #{knowledgeId}
    </delete>
    
    <delete id="deleteChunkById" parameterType="Long">
        delete from ai_knowledge_chunk where chunk_id = #{chunkId}
    </delete>
    
</mapper>
